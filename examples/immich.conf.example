# Settings for uploading drone photos and videos to Immich.
# Installed as /etc/dji-drone/immich.conf (readable by root only).
# Check them any time with: sudo dji-drone-sync.sh --check

# The address you open Immich at in a web browser, including the port.
IMMICH_URL=http://192.168.1.50:2283

# An API key made in Immich: click your profile picture > Account Settings
# > API Keys > New API Key. It needs these permissions:
#   asset.upload, album.read, album.create, albumAsset.create
IMMICH_API_KEY=CHANGE_ME

# The album the photos and videos go into. It is created if it doesn't exist.
IMMICH_ALBUM=Drone Photos

# ---- Dock settings ----

# yes = delete each photo/video from the drone as soon as its copy on the
# Pi has been checked (compared byte for byte), BEFORE uploading. The
# drone's storage is then free when you unplug it. Until the upload
# finishes, the Pi holds the only copy.
# no = never delete anything from the drone.
DELETE_FROM_DRONE=yes

# The most the cache on the Pi may hold, in GB. Files that don't fit stay
# on the drone until the cache has been uploaded and has room again (if
# the drone is still plugged in), or until the next time you plug it in.
# The Pi's SD card is 64 GB: the system takes about 3-8 GB, the RC 2
# dock very little, so 20 GB leaves plenty of room.
CACHE_LIMIT_GB=20

# Always leave this much of the Pi's SD card free, in GB, for the system
# and other programs (like the RC 2 dock's flight log cache).
KEEP_FREE_GB=5

# While the drone stays plugged in with files still on it (because the
# cache was full): how often, in minutes, to check if the cache has been
# uploaded and emptied, so it can be refilled from the drone.
REFILL_CHECK_MINUTES=5

# Stop waiting for the cache to empty after this many hours (e.g. if
# Immich is down). The rest stays on the drone for the next plug-in.
REFILL_GIVE_UP_HOURS=12
